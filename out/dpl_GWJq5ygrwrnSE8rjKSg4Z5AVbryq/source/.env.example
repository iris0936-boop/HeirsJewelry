# Copy any of these into .env (committed) or Vercel → Settings → Environment Variables.

# Shopify (checkout). Public Storefront token from the Headless sales channel.
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=xxxxxxxx

# Where diamonds and ring settings come from.
#   csv     (default) inventory/diamonds.csv or INVENTORY_URL; ring settings from src/data/designs.ts.
#           The ring builder works, but checkout falls back to "Request this ring".
#   shopify Shopify products with product type "Diamond" and "Setting". Enables online checkout.
# INVENTORY_SOURCE=shopify

# Optional, csv mode only. Google Sheet published as CSV (File > Share > Publish to web > CSV).
# INVENTORY_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv
